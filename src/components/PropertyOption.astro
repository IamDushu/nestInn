---
interface Props {
    img: string;
	title: string;
	body: string;
}

const { img, title, body } = Astro.props;
---

<div class="space-y-4">
	<h3 class="text-3xl font-bold text-gray-800 font-luxury">{title}</h3>
    <div class="h-[240px]">
        <a href="/homestay-tirupati">
            <img src={img} alt="homestay in tirupati" class="w-[100%] h-[100%] object-cover">
        </a>
    </div>
    <p class="text-gray-500 leading-8 text-md ">{body}</p>
   
</div>
